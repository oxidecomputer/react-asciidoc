{
  "name": "@oxide/react-asciidoc",
  "version": "1.1.4",
  "files": [
    "dist"
  ],
  "description": "React renderer for AsciiDoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxidecomputer/react-asciidoc.git"
  },
  "main": "./dist/react-asciidoc.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/react-asciidoc.js",
      "require": "./dist/react-asciidoc.umd.cjs"
    }
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "scripts": {
    "dev": "vite --port 8000",
    "clean": "rimraf dist/",
    "build": "npm run clean && vite build && tsc",
    "test:init": "rm -rf ./tests/renderer.spec.ts-snapshots & npx playwright test -g html",
    "test:run": "npx playwright test -g react",
    "release": "auto shipit",
    "fmt": "prettier --write --ignore-path ./.gitignore  .",
    "fmt:check": "prettier --check --ignore-path ./.gitignore . ",
    "tsc": "tsc"
  },
  "author": "Oxide Computer Company <bots@oxidecomputer.com>",
  "license": "MPL 2.0",
  "dependencies": {
    "html-react-parser": "^5.1.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.5.2",
    "@types/react": "^18.0.18",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^5.0.3",
    "auto": "^11.3.0",
    "classnames": "^2.5.1",
    "eslint": "^9.36.0",
    "html-entities": "^2.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "rollup-plugin-dts": "^6.2.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-dts": "^1.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "@asciidoctor/core": "^3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "auto": {
    "plugins": [
      [
        "npm",
        {
          "setRcToken": false
        }
      ],
      "released"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
